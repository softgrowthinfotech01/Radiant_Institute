#Alternate default index page
# Site root serves home.php; /admin/ falls through to admin/index.php
DirectoryIndex home.php index.php index.html

ErrorDocument 404 /resourt.php

RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php

RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html


Options -Indexes

<files .htaccess>

</files>